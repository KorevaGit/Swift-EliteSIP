# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# SwiftPM
.build/
.swiftpm/
# У локальных пакетов Package.resolved — шум: разрешать там нечего.
Packages/*/Package.resolved
Tools/*/Package.resolved
# А вот у приложения он хранится намеренно (M7h): с появлением Sparkle это
# единственное место, где записан точный коммит выкачанной зависимости.
# Номер версии в project.pbxproj говорит «2.9.6», но метку можно передвинуть —
# ревизия в Package.resolved зафиксирована.

# Lab secrets — TLS keys are generated locally, never committed
Lab/certs/*.pem
Lab/certs/*.key
Lab/certs/*.crt
Lab/certs/*.srl

# Local, machine-specific settings
Lab/.env
*.local.json

# Temporary HTML used while extracting Superdesign components
.superdesign/tmp/

# Снимки конфигов FreePBX-стенда — рабочие файлы, не история проекта
Lab/freepbx-snapshots/

# Установщики на сайте — артефакты выпуска, лежат в build/release и на сервере.
Site/downloads/
