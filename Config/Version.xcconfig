// Версия выпуска — одно место на весь проект.
//
// Раньше `MARKETING_VERSION` и `CURRENT_PROJECT_VERSION` стояли в двух
// конфигурациях цели сразу, и поднимать их надо было руками в обеих. Две сборки
// с одним номером — это жалоба, которую не по чему разбирать: оператор называет
// «0.1.0», а какой именно 0.1.0 у него стоит, не знает никто. Автообновлению
// (M7h) номер нужен ещё жёстче — как основание решения «обновлять или нет».
//
// Файл правит `Tools/release.sh` при выпуске (`--bump`), поэтому формат строк
// менять нельзя: скрипт ищет их по имени ключа в начале строки.
//
// MARKETING_VERSION — то, что видно человеку: мажор.минор.патч.
// CURRENT_PROJECT_VERSION — счётчик сборок, растёт на единицу при каждом
// выпуске и никогда не убывает. Sparkle сравнивает именно его.

MARKETING_VERSION = 0.1.15
CURRENT_PROJECT_VERSION = 17
