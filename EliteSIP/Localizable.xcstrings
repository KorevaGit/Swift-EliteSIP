{
  "sourceLanguage": "ru",
  "strings": {
    " — широкая полоса": {
      "comment": "пометка у широкополосного кодека",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " — wideband"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " — широкая полоса"
          }
        }
      }
    },
    "%1$@ · %2$@": {
      "comment": "сколько вызовов из очереди и когда последний",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%1$@ · %2$lld макр. · %3$lld очер.": {
      "comment": "что внутри предустановки",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld macros · %3$lld queues"
