        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum offset"
          }
        }
      }
    },
    "Минимум по RFC 4733 — 40 мс. Глухие голосовые меню лучше слышат 120.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RFC 4733 sets the minimum at 40 ms. Deaf voice menus hear 120 better."
          }
        }
      }
    },
