          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will finish the setup and open again, so the choice applies everywhere."
          }
        }
      },
      "extractionState": "stale"
    },
    "Приложение остаётся в доке. Щелчок по иконке возвращает панель.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
