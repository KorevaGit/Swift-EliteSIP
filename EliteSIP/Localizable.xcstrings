    "Профилей нет. Пока не заведён хотя бы один, звонить не с чего.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No profiles. Until at least one exists, there is nothing to call from."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профилей нет. Пока не заведён хотя бы один, звонить не с чего."
          }
        }
      }
    },
    "Профили": {
      "localizations": {
