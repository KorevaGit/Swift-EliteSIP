          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app lives in the menu bar. Clicking its icon shows and hides the panel."
          }
        }
      },
      "extractionState": "stale"
    },
    "Приложение закончит настройку и откроется заново — так выбор применится целиком.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
