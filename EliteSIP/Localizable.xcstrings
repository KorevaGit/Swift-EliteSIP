  "strings": {
    " — широкая полоса": {
      "comment": "пометка у широкополосного кодека"
    },
    "%1$@ · %2$@": {
      "comment": "сколько вызовов из очереди и когда последний"
    },
    "%1$@ · %2$lld макр. · %3$lld очер.": {
      "comment": "что внутри предустановки"
    },
    "%1$@ · до первой регистрации %2$@ с": {
