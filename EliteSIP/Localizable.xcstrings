    "Автокликер принимает лид быстрее коллег, не находясь за рабочим местом, и лид уходит в тишину.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An auto-clicker takes a lead faster than colleagues without anyone at the desk, and the lead goes to silence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автокликер принимает лид быстрее коллег, не находясь за рабочим местом, и лид уходит в тишину."
          }
        }
      }
    },
