          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld макр. · %3$lld очер."
          }
        }
      }
    },
    "%1$@ · до первой регистрации %2$@ с": {
      "comment": "сколько пакетов стука и сколько это займёт",
      "localizations": {
