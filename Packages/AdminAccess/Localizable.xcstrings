{
  "sourceLanguage": "ru",
  "strings": {
    "Данные административного доступа испорчены. Задайте пароль заново.": {
      "comment": "отказ доступа",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The administrator access data is corrupted. Set the password again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные административного доступа испорчены. Задайте пароль заново."
          }
        }
      }
    },
    "Код восстановления — это %lld цифр.": {
      "comment": "отказ доступа",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovery code is %lld digits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код восстановления — это %lld цифр."
          }
        }
      },
