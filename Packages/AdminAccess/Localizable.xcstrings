        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки из файла конфигурации"
          }
        }
      },
      "extractionState": "stale"
    },
    "Не удалось проверить пароль.": {
      "comment": "отказ доступа",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить пароль."
          }
        }
      }
    },
    "Неверный код восстановления.": {
      "comment": "отказ доступа",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong recovery code."
          }
        },
