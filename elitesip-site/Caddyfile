# Имя, под которым панель открывают внутри конторы.
support.elitesip.vip {
	# Сертификат берётся проверкой DNS-01, а не HTTP-01.
	#
	# Имя разрешается в 10.171.0.171 — адрес частной сети, — и постучаться к
	# нам снаружи Let's Encrypt не может по построению. DNS-01 доказывает
	# владение именем записью в зоне: до сервера ходить не надо, и панель
	# остаётся невидимой снаружи, получая при этом настоящий сертификат.
	#
	# Токен — только на правку DNS этой зоны, значением из окружения, а не
	# строкой в файле: файл лежит в Git, окружение — нет.
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Панель наружу порта не публикует вовсе: до неё дотягивается только Caddy,
	# по внутренней сети compose.
	reverse_proxy panel:8080

	# Журнал доступа — на случай «кто и когда выпустил ключ». Сама панель ведёт
	# свой журнал действий, но он про действия, а этот про запросы.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Обращение по адресу вместо имени. Отвечает перенаправлением, а не отказом:
# админ, набравший 10.171.0.171 по памяти, не должен упереться в пустую
# страницу — браузер уедет на имя и получит там настоящий сертификат.
#
# Только http, и это осознанно. `https://10.171.0.171` тут стоял и не работал:
# публичный сертификат на адрес не выдают, а внутренний Caddy'ев браузер всё
# равно отвергнет с предупреждением. Половина слушателя, отвечающая
# предупреждением вместо страницы, хуже её отсутствия: набравший адрес с `https`
# получит внятный отказ соединения и наберёт имя.
http://10.171.0.171 {
	redir https://support.elitesip.vip{uri} permanent
}
