# Доступы к бакету R2. Заполнить и переименовать в .env.
#
# Права ключа — только запись в бакет панели. Читают файл машины, и чтение им
# даёт Worker, а не эти ключи.
ELITESIP_R2_ENDPOINT=https://<счёт>.r2.cloudflarestorage.com
ELITESIP_R2_BUCKET=elitesip-panel
ELITESIP_R2_ACCESS_KEY_ID=
ELITESIP_R2_SECRET_ACCESS_KEY=
